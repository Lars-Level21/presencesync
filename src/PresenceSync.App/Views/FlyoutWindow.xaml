<ui:FluentWindow
    x:Class="PresenceSync.App.Views.FlyoutWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PresenceSync.App.ViewModels"
    Title="PresenceSync"
    Width="380"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="18" Height="18" Source="{Binding StateGlyph}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock Text="PresenceSync" FontTypography="BodyStrong" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryText}" />
            </StackPanel>
            <ui:Button Grid.Column="2" Appearance="Transparent" Padding="8" ToolTip="Einstellungen"
                       Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenSettingsCommand}" />
        </Grid>

        <!-- Tenants -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Noch keine Tenants. Über die Einstellungen hinzufügen." TextWrapping="Wrap" Margin="0,0,0,12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTenants}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Tenants}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TenantItemViewModel}">
                        <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Width="16" Height="16" Source="{Binding Glyph}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                               x:Name="DetailText" />
                                </StackPanel>
                                <ui:Button Grid.Column="2" Content="Anmelden" Appearance="Caution" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Command="{Binding SignInCommand}"
                                           Visibility="{Binding NeedsSignIn, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Grid.Column="3" Appearance="Transparent" Padding="6" Margin="4,0,0,0"
                                           VerticalAlignment="Center" ToolTip="Status für diesen Tenant"
                                           Icon="{ui:SymbolIcon MoreHorizontal24}" Click="OnTenantMenuClick" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Quick actions for all tenants -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0"
                    Visibility="{Binding HasTenants, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Alle Tenants" Style="{StaticResource SecondaryText}" Margin="2,0,0,6" />
            <UniformGrid Columns="2">
                <ui:Button Margin="0,0,4,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Icon="{ui:SymbolIcon PresenceDnd24}" Content="Nicht stören · 1 h"
                           Command="{Binding QuickDoNotDisturbCommand}" />
                <ui:Button Margin="4,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Icon="{ui:SymbolIcon Call24}" Content="Beschäftigt · 1 h"
                           Command="{Binding QuickBusyCommand}" />
                <ui:Button Margin="0,4,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Icon="{ui:SymbolIcon PresenceAway24}" Content="Gleich zurück · 30 min"
                           Command="{Binding QuickAwayCommand}" />
                <ui:Button Margin="4,4,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Content="Zurücksetzen"
                           Command="{Binding ResetAllCommand}" />
            </UniformGrid>
            <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Appearance="Transparent"
                       Content="Weitere Status und Dauer …" Click="OnMoreStatusClick" />
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:ToggleSwitch Content="Auto-Sync" IsChecked="{Binding AutoSync}" VerticalAlignment="Center"
                                 IsEnabled="{Binding IsConfigured}" />
                <ui:Button Grid.Column="1" Appearance="Transparent" Padding="8" ToolTip="Log öffnen"
                           Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding OpenLogCommand}" />
                <ui:Button Grid.Column="2" Appearance="Transparent" Padding="8" ToolTip="PresenceSync beenden"
                           Icon="{ui:SymbolIcon Power24}" Command="{Binding ExitCommand}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
