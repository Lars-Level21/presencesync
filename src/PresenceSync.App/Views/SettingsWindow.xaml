<ui:FluentWindow
    x:Class="PresenceSync.App.Views.SettingsWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:PresenceSync.Core.Resources;assembly=PresenceSync.Core"
    xmlns:vm="clr-namespace:PresenceSync.App.ViewModels"
    Title="{x:Static res:Strings.Settings_WindowTitle}"
    Width="760"
    Height="820"
    MinWidth="560"
    MinHeight="480"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,20,0,8" />
        </Style>
        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.Settings_WindowTitle}" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:TextBlock Text="{x:Static res:Strings.Settings_Heading}" FontTypography="Title" Margin="0,4,0,0" />
                <ui:InfoBar Title="{x:Static res:Strings.Settings_PolicyTitle}" IsOpen="{Binding IsPolicyActive, Mode=OneTime}" IsClosable="False"
                            Severity="Informational" Margin="0,12,0,0"
                            Message="{x:Static res:Strings.Settings_PolicyText}" />

                <!-- Connection -->
                <TextBlock Text="{x:Static res:Strings.Settings_SectionConnection}" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Icon="{ui:SymbolIcon Key24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Settings_ClientId}" />
                            <TextBlock Text="{x:Static res:Strings.Settings_ClientIdHint}" Style="{StaticResource Description}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBox Width="320" Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsClientIdEditable, Mode=OneTime}"
                                    PlaceholderText="00000000-0000-0000-0000-000000000000" />
                        <TextBlock Text="{x:Static res:Strings.Settings_SetByOrganization}" Style="{StaticResource Description}" Margin="2,4,0,0"
                                   Visibility="{Binding IsClientIdLocked, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon ShieldCheckmark24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Settings_UseBroker}" />
                            <TextBlock Text="{x:Static res:Strings.Settings_UseBrokerHint}" Style="{StaticResource Description}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding UseBroker}" />
                </ui:CardControl>

                <!-- Tenants -->
                <TextBlock Text="{x:Static res:Strings.Settings_SectionTenants}" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource Description}" Margin="2,0,0,8"
                           Text="{x:Static res:Strings.Settings_TenantsHint}" />

                <ItemsControl ItemsSource="{Binding Tenants}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TenantRowViewModel}">
                            <Border Margin="0,0,0,4" Padding="16,12" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Building24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Static res:Strings.Settings_DisplayName}"
                                                    MaxWidth="280" HorizontalAlignment="Left" MinWidth="200" />
                                        <TextBlock Text="{Binding Upn}" Style="{StaticResource Description}" Margin="2,6,0,0" />
                                        <TextBlock Text="{Binding TenantId}" Style="{StaticResource Description}" Margin="2,0,0,0" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_ManagedTenantHint}"
                                                   Style="{StaticResource Description}" Margin="2,2,0,0"
                                                   Visibility="{Binding IsManaged, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Content="{x:Static res:Strings.Settings_Home}" IsChecked="{Binding IsHome}" Margin="12,0"
                                              VerticalAlignment="Center" ToolTip="{x:Static res:Strings.Settings_HomeTooltip}" />
                                    <ui:ToggleSwitch Grid.Column="3" IsChecked="{Binding Enabled}" OnContent="{x:Static res:Strings.Settings_Active}" OffContent="{x:Static res:Strings.Settings_Off}"
                                                     VerticalAlignment="Center" Margin="12,0" />
                                    <ui:Button Grid.Column="4" Appearance="Transparent" Padding="8" ToolTip="{x:Static res:Strings.Settings_RemoveTenant}"
                                               Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveCommand}" VerticalAlignment="Center"
                                               IsEnabled="{Binding CanRemove, Mode=OneTime}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:CardExpander Icon="{ui:SymbolIcon PersonAdd24}" Margin="0,4,0,0" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Settings_AddTenant}" />
                            <TextBlock Text="{x:Static res:Strings.Settings_AddTenantHint}" Style="{StaticResource Description}" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding NewTenantName, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{x:Static res:Strings.Settings_DisplayNameOptional}" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Person24}"
                                       Content="{x:Static res:Strings.Settings_ChooseAccount}" Command="{Binding AddTenantCommand}" />
                        </Grid>
                        <Expander Margin="0,12,0,0" Header="{x:Static res:Strings.Settings_Advanced}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource Description}" Margin="0,0,0,8"
                                           Text="{x:Static res:Strings.Settings_AdvancedHint}" />
                                <ui:TextBox Text="{Binding NewTenant, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{x:Static res:Strings.Settings_TenantPlaceholder}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ui:CardExpander>
                <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" Margin="0,8,0,0" HorizontalAlignment="Left"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <!-- Sync -->
                <TextBlock Text="{x:Static res:Strings.Settings_SectionSync}" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Common_AutoSync}" />
                            <TextBlock Text="{x:Static res:Strings.Settings_AutoSyncHint}" Style="{StaticResource Description}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding AutoSync}" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon Timer24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Settings_PollInterval}" />
                            <TextBlock Text="{x:Static res:Strings.Settings_PollIntervalHint}" Style="{StaticResource Description}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox Width="140" Value="{Binding PollIntervalSeconds}" Minimum="10" Maximum="300" SmallChange="5" MaxDecimalPlaces="0" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon Clock24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Settings_SessionExpiration}" />
                            <TextBlock Text="{x:Static res:Strings.Settings_SessionExpirationHint}" Style="{StaticResource Description}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox Width="140" Value="{Binding SessionExpirationMinutes}" Minimum="5" Maximum="240" SmallChange="5" MaxDecimalPlaces="0" />
                </ui:CardControl>

                <!-- Start & hotkeys -->
                <TextBlock Text="{x:Static res:Strings.Settings_SectionStartup}" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Icon="{ui:SymbolIcon Rocket24}" Header="{x:Static res:Strings.Settings_Autostart}">
                    <ui:ToggleSwitch IsChecked="{Binding Autostart}" />
                </ui:CardControl>
                <ui:CardExpander Icon="{ui:SymbolIcon Keyboard24}" IsExpanded="{Binding HotkeysEnabled, Mode=OneTime}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Settings_Hotkeys}" />
                                <TextBlock Text="{x:Static res:Strings.Settings_HotkeysHint}" Style="{StaticResource Description}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding HotkeysEnabled}" Margin="0,0,12,0" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Static res:Strings.Settings_HotkeyDnd}" VerticalAlignment="Center" Margin="0,0,16,8" />
                        <ui:TextBox Grid.Column="1" Text="{Binding HotkeyDoNotDisturb, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Settings_HotkeyReset}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HotkeyReset, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </ui:CardExpander>

                <ui:HyperlinkButton Content="{x:Static res:Strings.Settings_OpenConfig}" Command="{Binding OpenConfigFileCommand}"
                                    Icon="{ui:SymbolIcon Open24}" Margin="0,16,0,0" Padding="4"
                                    Visibility="{Binding CanOpenConfigFile, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:InfoBar Title="{Binding MessageTitle}" Message="{Binding Message}" Severity="{Binding MessageSeverity}"
                            IsOpen="{Binding HasMessage}" IsClosable="True" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="110" />
                    <ui:Button Content="{x:Static res:Strings.Common_Save}" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                               Command="{Binding SaveCommand}" MinWidth="110" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
